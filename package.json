{
  "name": "diary-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "node scripts/dev-desktop.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "vitest",
    "preview": "vite preview",
    "desktop:pack": "pnpm build && electron-builder --dir",
    "desktop:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "local.diary.desktop",
    "productName": "日记本",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ]
    }
  },
  "description": "本地优先的日记与待办桌面应用",
  "author": "76188"
}
